# Server Configuration
PORT=5000
NODE_ENV=production

# Allowed Frontend Origins (Comma-separated for multiple domains, e.g., Firebase Hosting domains)
CLIENT_URL=https://<your-project-id>.web.app,https://<your-project-id>.firebaseapp.com

# MongoDB Atlas Connection URI (Accepts either MONGODB_URI or MONGO_URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/thesehatbuddy?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/thesehatbuddy?retryWrites=true&w=majority

# JWT Authentication (Must be at least 32 characters in production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRE=30d

# Cloudinary Media Storage (For Doctor & Hospital photo/video uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo (Sendinblue) Email & OTP Service
EMAIL_FROM=thesehatbuddy@gmail.com
BREVO_SMTP_USER=your_brevo_smtp_user@smtp-brevo.com
BREVO_API_KEY=your_brevo_api_key_or_smtp_password
BREVO_DAILY_EMAIL_LIMIT=300

# Google OAuth 2.0 (For Patient Google Login)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Map & Routing Configuration (Distance matrix & routing)
MAP_ROUTING_PROVIDER=openrouteservice
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key

# Admin Security (Optional passkey for admin registration)
ADMIN_REGISTRATION_SECRET=your_optional_admin_registration_passkey

# Storage Monitoring Limits (Defaults to M0 512MB)
MONGODB_STORAGE_LIMIT_MB=512
MONGODB_PLAN_NAME=M0 Free Tier (512 MB)
