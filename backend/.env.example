PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sehatbuddy?retryWrites=true&w=majority

# JWT configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Cloudinary API Configuration (For Hospital & Doctor Image Uploads: Profile, Interior, Exterior, Custom Photos)
# Get your free Cloud Name, API Key & API Secret at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo configuration
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=noreply@sehatbuddy.com

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here

# Map & Routing Configuration
MAP_ROUTING_PROVIDER=openrouteservice
OPENROUTESERVICE_API_KEY=
