# Backend API Base URL (Points to Cloud Run service in production or localhost in development)
# In production: https://<your-cloud-run-service-url>.a.run.app
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

# Google OAuth Client ID (Configure in Google Cloud Console -> Credentials)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
